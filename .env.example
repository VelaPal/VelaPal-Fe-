# Same-origin browser API, forwarded exclusively to Express.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_UPSTREAM=http://localhost:4000
# Direct alternative: NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Express must allow the exact web Origin, credentials, preflight and
# X-CSRF-Token, If-Match, Idempotency-Key headers. Production requires HTTPS.
